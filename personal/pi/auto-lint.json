[
  {
    "match": "dotfiles/",
    "command": "npx prettier --ignore-path /Users/sam/dotfiles/.prettierignore --write {{file}}",
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".mts",
      ".css",
      ".md",
      ".json",
      ".yml",
      ".yaml"
    ]
  }
]
