{
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 16384
  },
  "customFooter": {
    "lines": [
      ["session", "session_name"],
      ["path", "git", "ext:pr-status"],
      ["model", "thinking", "tokens", "context", "ext:claude-cache-ttl"],
      ["ext:preset", "ext:*"]
    ]
  },
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "xhigh",
  "enableSkillCommands": true,
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-opus-4-6",
    "gpt-5.6-sol",
    "gpt-5.5-pro"
  ],
  "extensions": [],
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.99.1",
  "npmCommand": ["pnpm", "--config.node-version=22.22.2"],
  "packages": [
    {
      "extensions": ["-extensions/pi-autoresearch/index.ts"],
      "skills": [
        "-skills/autoresearch-create/SKILL.md",
        "-skills/autoresearch-finalize/SKILL.md"
      ],
      "source": "/Users/sam/dotfiles/personal/pi"
    },
    "npm:pi-web-access",
    "git:github.com/shopify-playground/shop-pi-fy",
    "git:github.com/shopify-playground/pi-tool-gateway-extension",
    {
      "extensions": ["-extensions/autoresearch-studio/index.ts"],
      "source": "https://github.com/jhochenbaum/pi-autoresearch-studio"
    },
    "git:github.com/JamesOwenHall/tidy-tools"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "theme": "gruvbox-rainbow",
  "thinkingBudgets": {
    "high": 32768,
    "low": 4096,
    "medium": 10240,
    "minimal": 1024
  }
}
